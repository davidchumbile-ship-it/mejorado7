<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Sans:wght@300;400;500&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --nav-bg: #0f0f11;
            --nav-border: #1e1e22;
            --surface: #16161a;
            --surface2: #1c1c21;
            --surface3: #222228;
            --accent: #e8533a;
            --accent2: #f07a65;
            --text: #f0ede8;
            --text-muted: #8a8890;
            --text-dim: #55545e;
            --border: #2a2a32;
        }

        body {
            background: var(--surface);
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
            min-height: 100vh;
        }

        nav {
            background: var(--nav-bg);
            border-bottom: 1px solid var(--nav-border);
            padding: 0 2rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            letter-spacing: -.02em;
            text-decoration: none;
        }

        .brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
        }

        .brand-sub {
            font-weight: 300;
            color: var(--text-dim);
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            margin-left: 4px;
        }

        .nav-links a {
            font-size: 13px;
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            transition: all .15s;
        }

        .nav-links a:hover {
            color: var(--text);
            background: var(--surface2);
        }

        .main {
            padding: 2.5rem 2rem;
            max-width: 680px;
            margin: 0 auto;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -.03em;
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
            margin-bottom: 1.5rem;
        }

        .card {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .card-body {
            padding: 1.5rem;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 1.5rem;
            padding: 1.25rem;
            background: var(--surface3);
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        .avatar-lg {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1a1c2d, #222540);
            border: 1px solid #2a2d45;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #6ba3d6;
            flex-shrink: 0;
        }

        .profile-name {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 17px;
        }

        .profile-email {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .field-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        .field label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--text-dim);
        }

        .field input {
            background: var(--surface3);
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 10px 13px;
            color: var(--text);
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            outline: none;
            transition: border .15s;
            width: 100%;
        }

        .field input:focus {
            border-color: #555;
        }

        .field input:disabled {
            opacity: .6;
            cursor: default;
        }
    </style>
</head>

<body>

    <nav>
        <a href="#" class="brand"><span class="brand-dot"></span>App JWT<span class="brand-sub">/ Perfil</span></a>
        <div class="nav-links">
            <a href="javascript:history.back()">← Volver</a>
        </div>
    </nav>

    <div class="main">
        <h1 class="page-title">Mi Perfil</h1>
        <p class="page-subtitle">Datos de tu cuenta</p>

        <div class="card">
            <div class="card-body">
                <div class="profile-header">
                    <div class="avatar-lg" id="profileAvatar"></div>
                    <div>
                        <div class="profile-name" id="profileName"></div>
                        <div class="profile-email" id="profileEmail"></div>
                    </div>
                </div>
                <div class="field-group">
                    <div class="field">
                        <label>Nombre</label>
                        <input id="name" type="text" disabled>
                    </div>
                    <div class="field">
                        <label>Apellido</label>
                        <input id="lastName" type="text" disabled>
                    </div>
                    <div class="field full">
                        <label>Correo electrónico</label>
                        <input id="email" type="email" disabled>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            protectRoute([], (user) => {
                const initials = ((user.name?.[0] || '') + (user.lastName?.[0] || '')).toUpperCase();
                document.getElementById('profileAvatar').textContent = initials;
                document.getElementById('profileName').textContent = `${user.name} ${user.lastName}`;
                document.getElementById('profileEmail').textContent = user.email;
                document.getElementById('name').value = user.name;
                document.getElementById('lastName').value = user.lastName;
                document.getElementById('email').value = user.email;
            });
        });
    </script>
</body>

</html>