<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;700&family=DM+Sans:wght@300;400;500&display=swap"
        rel="stylesheet">
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --nav-bg: #0f0f11;
            --nav-border: #1e1e22;
            --surface: #16161a;
            --surface2: #1c1c21;
            --surface3: #222228;
            --accent: #e8533a;
            --accent2: #f07a65;
            --text: #f0ede8;
            --text-muted: #8a8890;
            --text-dim: #55545e;
            --border: #2a2a32;
        }

        body {
            background: var(--surface);
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
            min-height: 100vh;
        }

        /* ── NAV ── */
        nav {
            background: var(--nav-bg);
            border-bottom: 1px solid var(--nav-border);
            padding: 0 2rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 17px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text);
            letter-spacing: -0.02em;
            text-decoration: none;
        }

        .brand-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
        }

        .brand-sub {
            font-weight: 300;
            color: var(--text-dim);
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            margin-left: 4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .nav-links a {
            font-size: 13px;
            color: var(--text-muted);
            padding: 6px 14px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 400;
            transition: all .15s;
        }

        .nav-links a:hover {
            color: var(--text);
            background: var(--surface2);
        }

        .nav-links .logout {
            margin-left: 8px;
            color: var(--accent2);
            border: 1px solid #3d2119;
            border-radius: 6px;
            padding: 5px 14px;
            font-size: 13px;
            cursor: pointer;
            background: transparent;
            font-family: 'DM Sans', sans-serif;
            transition: all .15s;
        }

        .nav-links .logout:hover {
            background: #2d1a18;
        }

        /* ── MAIN ── */
        .main {
            padding: 2.5rem 2rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 2rem;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--text);
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .stat-pills {
            display: flex;
            gap: 10px;
        }

        .stat-pill {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }

        .stat-pill strong {
            font-size: 20px;
            color: var(--text);
            font-family: 'Syne', sans-serif;
            font-weight: 700;
        }

        /* ── CARD / TABLE ── */
        .card {
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .card-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .card-header-label {
            font-size: 11px;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--text-dim);
            font-weight: 500;
        }

        .search-input {
            background: var(--surface3);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 5px 12px;
            color: var(--text);
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            width: 180px;
            outline: none;
            transition: border .15s;
        }

        .search-input:focus {
            border-color: #444;
        }

        .search-input::placeholder {
            color: var(--text-dim);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead tr {
            border-bottom: 1px solid var(--border);
        }

        th {
            padding: 10px 16px;
            font-size: 11px;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--text-dim);
            font-weight: 500;
            text-align: left;
        }

        tbody tr {
            border-bottom: 1px solid #1e1e24;
            transition: background .1s;
            cursor: default;
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: var(--surface3);
        }

        td {
            padding: 13px 16px;
            font-size: 14px;
            color: var(--text);
        }

        .user-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: linear-gradient(135deg, #2d1a18, #3d2520);
            border: 1px solid #3d2520;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 11px;
            color: var(--accent2);
            flex-shrink: 0;
        }

        .user-name {
            font-weight: 500;
            font-size: 14px;
        }

        .email-cell {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 300;
        }

        .roles-cell {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 5px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .03em;
        }

        .badge.admin {
            background: #2d1a18;
            color: #f07a65;
            border: 1px solid #3d1f1a;
        }

        .badge.user {
            background: #151d2d;
            color: #6ba3d6;
            border: 1px solid #1a2d45;
        }

        .badge.moderator {
            background: #1a1f17;
            color: #7ab87a;
            border: 1px solid #1f2e1f;
        }

        .action-btn {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 5px 12px;
            font-size: 12px;
            color: var(--text-muted);
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            transition: all .15s;
        }

        .action-btn:hover {
            border-color: #444;
            color: var(--text);
            background: var(--surface3);
        }

        .empty {
            padding: 3rem;
            text-align: center;
            color: var(--text-dim);
            font-size: 14px;
        }
    </style>
</head>

<body>

    <nav>
        <a href="#" class="brand">
            <span class="brand-dot"></span>
            App JWT
            <span class="brand-sub">/ Admin</span>
        </a>
        <div class="nav-links">
            <a href="/dashboard/user">Dashboard User</a>
            <a href="/profile">Mi Perfil</a>
            <button class="logout" id="logoutBtn">Cerrar sesión</button>
        </div>
    </nav>

    <div class="main">
        <div class="page-header">
            <div>
                <h1 class="page-title">Usuarios</h1>
                <p class="page-subtitle">Gestión de cuentas y permisos</p>
            </div>
            <div class="stat-pills">
                <div class="stat-pill"><strong id="totalUsers">—</strong>Total</div>
                <div class="stat-pill"><strong id="adminCount">—</strong>Admins</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-header-label">Registro de usuarios</span>
                <input class="search-input" type="text" id="searchInput" placeholder="Buscar usuario...">
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Roles</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <tr>
                        <td colspan="4" class="empty">Cargando usuarios...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
        function initials(name, lastName) {
            return ((name?.[0] || '') + (lastName?.[0] || '')).toUpperCase();
        }

        function badgeClass(role) {
            const map = { admin: 'admin', user: 'user', moderator: 'moderator' };
            return map[role] || 'user';
        }

        function renderUsers(users) {
            const tbody = document.getElementById('usersTableBody');
            if (!users.length) {
                tbody.innerHTML = '<tr><td colspan="4" class="empty">Sin resultados</td></tr>';
                return;
            }
            tbody.innerHTML = users.map(u => `
        <tr>
          <td>
            <div class="user-cell">
              <div class="avatar">${initials(u.name, u.lastName)}</div>
              <div class="user-name">${u.name} ${u.lastName}</div>
            </div>
          </td>
          <td class="email-cell">${u.email}</td>
          <td>
            <div class="roles-cell">
              ${u.roles.map(r => `<span class="badge ${badgeClass(r.name)}">${r.name}</span>`).join('')}
            </div>
          </td>
          <td>
            <button class="action-btn" onclick="alert('Info de ${u.email}')">Ver info →</button>
          </td>
        </tr>
      `).join('');
        }

        let allUsers = [];

        document.addEventListener('DOMContentLoaded', () => {
            protectRoute(['admin'], async (user) => {
                const token = sessionStorage.getItem('token');
                const res = await fetch('/api/users', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (res.ok) {
                    allUsers = await res.json();

                    document.getElementById('totalUsers').textContent = allUsers.length;
                    document.getElementById('adminCount').textContent =
                        allUsers.filter(u => u.roles.some(r => r.name === 'admin')).length;

                    renderUsers(allUsers);
                }
            });
        });

        document.getElementById('searchInput').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            renderUsers(allUsers.filter(u =>
                (u.name + ' ' + u.lastName + ' ' + u.email).toLowerCase().includes(q)
            ));
        });
    </script>
</body>

</html>